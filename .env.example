# ============================================
# ABC Express AIP — Environment Variables
# ============================================
# Copy this to .env and fill in values

# Database
DATABASE_URL="postgresql://abc_user:abc_pass@localhost:5432/abc_express?schema=public"

# Seed: set to 1 to generate random @abcexpress.local emails + one shared random password (printed at end of `pnpm db:seed`). Omit or 0 to use fixed @abcexpress.id + password123.
# SEED_DEV_RANDOM=0

# Redis
REDIS_URL="redis://localhost:6379"

# Background jobs (BullMQ) — run `pnpm --filter @abc/api worker` in a separate process to process the queue
WORKER_CONCURRENCY=5

# API
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="24h"
# URL of the Express app used by `apps/web` rewrites in next.config.js (not the Next dev server)
API_URL="http://localhost:4000"

# Frontend
# Browser client uses the Next origin (e.g. :3000) and /api rewrites to API_URL — leave unset or set for SSR
# NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# AI Service (apps/ai — default port 3334, see apps/ai/src/config.py)
AI_SERVICE_URL="http://localhost:3334"
ANTHROPIC_API_KEY=""
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_BASE_URL="https://agentrouter.org/"
# Model for Anthropic (shared by apps/ai Python and apps/api in-process Deep Agent)
# ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# In-process JS Deep Agent (POST /api/ai/deep-agent — apps/api + @abc/deep-agent). Same ANTHROPIC_* as above.
DEEP_AGENT_ENABLED=false

# Skill-registry inject (Python apps/ai + @abc/deep-agent): loads packages/ai-skills/inject.md into system prompt. Set 0 to disable.
ABC_AI_SKILLS_INJECT=1

# Optional: 17Track API for logistics-tracking MCP / carrier tools (see packages/ai-skills/skill-bundles.md)
# TRACK17_API_KEY=
# Optional: remote sandbox for Deep Agents (`pip install -e 'apps/ai[sandbox]'`)
SANDBOX_ENABLED=false
SANDBOX_PROVIDER=none
# SANDBOX_PROVIDER=daytona  # requires DAYTONA_API_KEY and langchain-daytona

# Logging
LOG_LEVEL="debug"
NODE_ENV="development"
